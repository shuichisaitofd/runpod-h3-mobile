FROM ghcr.io/shuichisaitofd/runpod-h3-mobile:h3-cu130-latest

USER root

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd /root/.ssh \
    && chmod 700 /root/.ssh \
    && printf '%s\n' \
       'PermitRootLogin prohibit-password' \
       'PasswordAuthentication no' \
       'PubkeyAuthentication yes' \
       > /etc/ssh/sshd_config.d/99-runpod-full-ssh.conf

COPY run-ssh.sh /run-h3-ssh.sh
RUN chmod +x /run-h3-ssh.sh

EXPOSE 22

ENTRYPOINT ["/run-h3-ssh.sh"]
