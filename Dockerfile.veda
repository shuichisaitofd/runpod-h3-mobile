# Long-video TEST image (branch h3-longtest, tags h3-longtest-*): the Veda image + Herrgott's continuation nodes (installed at boot) + /opt/h3-veda/h3_long_test.py.
# H3 Veda test image: the production image + a background first-boot setup that installs
# ComfyUI v0.38.0 (if needed), Veda (60bfae6) and its predictor model. Production (main) is not touched.
# lora_routes.py below is the veda branch's own copy (adds MysticXXX_MMH3-V5, cxy_kiss_v3, nipplesuck-k3nk, jav-voice, HMPussyV2 and Rough.Sex for the veda side only; also holds the 10Eros-Max INT8 downloads (beta7 raw auto at startup, old v2 on demand) and excludes the stock FL2VA download).
FROM ghcr.io/shuichisaitofd/runpod-h3-mobile:h3-cu130-latest
COPY h3-mobile/lora_routes.py /opt/comfyui-baked/custom_nodes/ComfyUI-H3-Mobile/lora_routes.py
COPY veda-image/veda-boot-setup.sh /opt/h3-veda/veda-boot-setup.sh
COPY veda-image/run-h3-veda.sh /run-h3-veda.sh
COPY veda-image/h3_long_test.py /opt/h3-veda/h3_long_test.py
RUN chmod +x /opt/h3-veda/veda-boot-setup.sh /run-h3-veda.sh && bash -n /opt/h3-veda/veda-boot-setup.sh && bash -n /run-h3-veda.sh
# Long-video test image: allow GPUs other than the RTX A6000 (for example L40S). veda-boot-setup.sh step 2c turns SageAttention off in the workflows on those GPUs.
RUN python3.12 -c "p='/run-h3.sh'; s=open(p).read(); a='assert cap == (8, 6), f\"Expected SM86, got {cap}\"'; assert a in s; s=s.replace(a, 'print(\"[H3] Not SM86: SageAttention will be turned off in the workflows\") if cap != (8, 6) else None'); open(p,'w').write(s)" && ! grep -q 'Expected SM86' /run-h3.sh && bash -n /run-h3.sh
ENTRYPOINT ["/run-h3-veda.sh"]
